{
	"name": "pencil-layer",
	"version": "1.0.0",
	"description": "Handwrite, sketch, and highlight on top of your notes with a stylus (Obsidian plugin).",
	"main": "main.js",
	"private": true,
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc --noEmit -skipLibCheck && node esbuild.config.mjs production",
		"test": "vitest run",
		"lint": "eslint .",
		"version": "node version-bump.mjs && git add manifest.json versions.json"
	},
	"author": "standw7",
	"license": "MIT",
	"devDependencies": {
		"@codemirror/commands": "6.11.1",
		"@codemirror/state": "6.7.6",
		"@codemirror/view": "6.43.13",
		"@types/node": "^22.10.0",
		"esbuild": "^0.25.0",
		"eslint": "^9.39.5",
		"eslint-plugin-obsidianmd": "^0.6.0",
		"obsidian": "1.14.4",
		"tslib": "^2.8.1",
		"typescript": "~5.9.3",
		"typescript-eslint": "^8.73.0",
		"vitest": "^3.2.7"
	},
	"dependencies": {
		"html-to-image": "1.11.13",
		"perfect-freehand": "^1.2.3"
	}
}
